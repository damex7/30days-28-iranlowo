# Copy to .env.local and fill in. Never commit .env.local.

# Neon: Project -> Connection details -> pooled connection string
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
APP_URL="http://localhost:3028"

# AI: 'gemini' or 'mock'. With no GEMINI_API_KEY the app uses the mock provider automatically.
AI_PROVIDER="gemini"
# Free key from https://aistudio.google.com/apikey (server-only; never exposed to the browser)
GEMINI_API_KEY=""
# Check current names at https://ai.google.dev/gemini-api/docs/models
AI_MODEL="gemini-3.5-flash-lite"
AI_FAST_MODEL="gemini-3.1-flash-lite"

# Email: without a key, emails print to the terminal
RESEND_API_KEY=""
EMAIL_FROM="Ọjà Express Support <onboarding@resend.dev>"

# Protects /api/cron/daily (Vercel sends it as a Bearer token)
CRON_SECRET="generate-a-long-random-string"

# Passwords for seeded accounts (npm run db:seed)
SEED_USER_PASSWORD="choose-a-password-for-seeded-customers-and-agents"
SEED_ADMIN_PASSWORD="choose-a-different-admin-password"

# Optional low caps (defaults shown)
# DAILY_MESSAGE_CAP=40
# CONVERSATION_MESSAGE_CAP=30
# CHAT_PER_MINUTE=6

# Optional: "server" makes the server run order lookups itself (for models with weak function calling)
# AI_TOOL_MODE=native
